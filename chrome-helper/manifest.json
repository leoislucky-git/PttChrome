{
  "manifest_version": 3,
  "name": "PttChrome WebSocket 版",
  "version": "1.0.6",
  "minimum_chrome_version": "101",
  "description": "保留經典介面，支援 WebSocket 直連與新版文章狀態辨識。搭配 PttChrome WebSocket 網頁版使用。",
  "homepage_url": "https://leoislucky-git.github.io/PttChrome/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://leoislucky-git.github.io/*",
    "wss://ws.ptt.cc/*",
    "wss://ws.ptt2.cc/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ptt_connection",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
