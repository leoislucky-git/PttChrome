{
  "manifest_version": 3,
  "name": "PttChrome 連線助手（非官方維護版）",
  "version": "1.0.3",
  "minimum_chrome_version": "101",
  "description": "協助 leoislucky-git 的 PttChrome 網頁版直接連線 PTT／PTT2，保留原本介面；僅調整指定連線的來源標頭。",
  "homepage_url": "https://leoislucky-git.github.io/PttChrome/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://leoislucky-git.github.io/*",
    "wss://ws.ptt.cc/*",
    "wss://ws.ptt2.cc/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ptt_connection",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
